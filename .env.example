# ============================================================
# .env.example — Asistente Jurídico IA
# Copiar a .env y completar con valores reales.
# NUNCA subir .env a Git.
# ============================================================

# ── Base de datos ─────────────────────────────────────────────
POSTGRES_DB=asistente_juridico
POSTGRES_USER=aj_user
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000
CONNECTION_STRING=Host=postgres;Port=5432;Database=asistente_juridico;Username=aj_user;Password=CAMBIAR_EN_PRODUCCION

# ── JWT (completar en Fase 3) ─────────────────────────────────
JWT_SECRET=CAMBIAR_EN_PRODUCCION_MINIMO_32_CARACTERES
JWT_ISSUER=AsistenteJuridicoIA
JWT_AUDIENCE=AsistenteJuridicoIA_Client
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=4200

# ── IA (completar en Fase 7) ──────────────────────────────────
AI_PROVIDER=Mock
AI_API_KEY=CAMBIAR_EN_PRODUCCION

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4200
