{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Issuer": "AsistenteJuridicoIA",
    "Audience": "AsistenteJuridicoClients",
    "ExpiresInMinutes": 15
  },
  "FileStorage": {
    "BasePath": "storage"
  },
  "RateLimiting": {
    "AI": {
      "UserPermitLimit": 15,
      "TenantPermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "AI": {
    "OpenAICompatible": {
      "TimeoutSeconds": 60
    }
  }
}
